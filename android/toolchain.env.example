# Contour toolchain for Linux / WSL. Copy to toolchain.env (gitignored), adjust the paths, then run
# android/wsl-build.sh (it sources toolchain.env, or this example when there is no copy).
# Nothing here is a system variable; it only lives in the shell that sources it.
export JAVA_HOME=$HOME/Android/jdk                  # JDK 21 (e.g. Eclipse Temurin 21 LTS)
export ANDROID_HOME=$HOME/Android/sdk               # platforms android-36 + android-37.2, build-tools 36+
export GRADLE_USER_HOME=$HOME/Android/gradle-home   # Gradle caches
export PATH="$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH"
# Optional: keep build output off the repo (outputs then land in $CONTOUR_BUILD_ROOT/<module>/outputs/).
# export CONTOUR_BUILD_ROOT=$HOME/Android/build/contour
# Optional, maintainer only: a properties file for release signing (see app/build.gradle.kts).
# export CONTOUR_SIGNING=$HOME/keys/contour/release.properties
