<?xml version="1.0" encoding="utf-8"?>
<!-- Used only by the perf build type (see app/build.gradle.kts): a launcher name of its own and
     profileable from the shell, so Perfetto and simpleperf can look inside a release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="${perfLabel}"
        tools:replace="android:label">
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>

</manifest>
