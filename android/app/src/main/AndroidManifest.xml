<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The DAC's HID interface is driven through the USB host API (UsbManager). -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Haptics composes vibration primitives through Vibrator; without this every tick throws SecurityException. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".ContourApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Contour">

        <!-- One MainActivity (singleTask): "Open with Contour" and a share start the Activity inside the caller's task, and a second instance beside the one in
             Contour's own task meant two DAC controllers on one USB device and page requests taken by the hidden instance (no slide to EQ after an import).
             The configuration changes listed are handled in place (the UI is all Compose): a recreated Activity makes a new DAC controller, which reads the
             DAC and visits its slots again - a split screen, a fold or a keyboard-class USB device did that. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A .txt from Files / Downloads ("Open with Contour") or shared from a browser: an EQ text, imported after a
                 confirmation. Read through the content URI grant; the app asks for no storage permission. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- A supported DAC plugged in: Android offers to open Contour ("Open Contour to handle ...?"). The filter sits on this alias, not on
             MainActivity, so OPEN CONTOUR WHEN A DAC IS PLUGGED IN (usb/AttachOpen.kt) can switch it off: a disabled alias is no match, so no pop-up.
             Never rename the alias - a new name is a new component, enabled again for everyone who switched it off. The device list
             (res/xml/device_filter.xml) is generated at build time from the device records in the repo (devices folder). -->
        <activity-alias
            android:name=".UsbAttachLauncher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity-alias>
    </application>

</manifest>
