    <!-- Whether the messages of :core (English) are shown from the resources below (core_*) instead of as they are. False here: the English build shows the text of :core exactly as it is -->
    <bool name="translate_core_text">false</bool>
    <!-- What stands between the items of a list of notes ("a; b; c"); the quotes keep the space -->
    <string name="list_separator">"; "</string>

