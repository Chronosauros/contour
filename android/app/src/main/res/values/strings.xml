    <string name="reason_not_confirmed_silent">NOT CONFIRMED: the DAC is back on USB but does not answer; unplug it, plug it back in, then tap to read it</string>

    <!-- Factory reset: why it stopped (shown in the FACTORY RESET STOPPED sheet) -->
    <string name="reset_failure_busy_nothing_sent">Contour is still working on the DAC. Nothing was sent.</string>
    <string name="reset_failure_no_dac">NO DAC. Nothing was sent.</string>
    <string name="reset_failure_no_permission">NO PERMISSION. Nothing was sent.</string>
    <string name="reset_failure_not_replugged">The DAC was not unplugged and plugged back in. Unplug it, plug it in again, then write the saved copy back.</string>
    <string name="reset_failure_not_replugged_kept">The DAC was not unplugged and plugged back in. Unplug it, plug it in again, then write the saved copy back; the copy is kept.</string>
