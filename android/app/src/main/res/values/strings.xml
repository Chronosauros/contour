    <string name="error_switch_failed">switch failed: %1$s</string>
    <string name="error_rename_failed">rename failed: %1$s</string>
    <string name="error_read_failed">read failed: %1$s</string>
    <string name="error_test_write_failed">test write failed: %1$s</string>
    <string name="error_restore_flat_failed">restore flat failed: %1$s</string>

    <!-- Why a send or an A/B switch did not happen (the details sheet of FAILED - HOLD TO RETRY, the line under the controls) -->
    <string name="send_reason_unknown">Unknown reason</string>
    <string name="reason_no_dac">NO DAC</string>
    <string name="reason_no_permission">NO PERMISSION</string>
    <string name="reason_dac_busy">DAC BUSY</string>
    <string name="reason_dac_detached">DAC DETACHED</string>
    <string name="reason_dac_state_unknown">DAC STATE UNKNOWN</string>
