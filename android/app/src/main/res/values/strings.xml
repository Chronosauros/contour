    <string name="reset_failure_copy_inexact_names">The copy of the DAC cannot be written down exactly (a slot name with a space or an odd character).</string>
    <string name="reset_failure_copy_inexact">The copy of the DAC cannot be written down exactly.</string>
    <string name="reset_failure_copy_unsaved">The copy of the DAC could not be saved on the phone.</string>

