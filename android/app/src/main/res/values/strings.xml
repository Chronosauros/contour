    <string name="failure_mismatch">The DAC reads back something different from what was sent. Send again.</string>
    <string name="failure_gone">The DAC was unplugged or changed. Plug it in and try again.</string>
    <string name="failure_slot">The DAC switched to a different slot than expected. Try again.</string>
    <string name="failure_generic">Couldn\'t talk to the DAC. Unplug it, plug it back in and try again.</string>
