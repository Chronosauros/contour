<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window before the first frame (the start window, the splash screen on Android 12 and later) follows the system theme as the app does (ContourTheme):
         light in light, dark in dark - before 1.8.1 it was always the dark Material grey, a dark flash in light theme (audit 10.11.2026, T9). The colours are the
         app's own page backgrounds (Theme.kt, LightPalette.bg and DarkPalette.bg), and the bar icons are dark on the light window. The parent stays the dark
         Material theme, so nothing the platform draws after start (text selection toolbar, system dialogs) changes. -->
    <style name="Theme.Contour.Base" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <!-- The bars in the window's own colour: the dark Material parent paints them black, and dark icons on black bars were invisible until
             enableEdgeToEdge ran after the first frame (Android 9-14; review 18.11.2026). -->
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:windowLightStatusBar">@bool/window_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_bars</item>
    </style>
    <style name="Theme.Contour" parent="Theme.Contour.Base" />

    <color name="window_background">#EFECE8</color>
    <bool name="window_light_bars">true</bool>
</resources>
