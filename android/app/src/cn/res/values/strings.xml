    <string name="reason_no_dac">未检测到 DAC</string>
    <string name="reason_no_permission">没有 USB 权限</string>
    <string name="reason_dac_busy">DAC 正忙</string>
    <string name="reason_dac_detached">DAC 已断开</string>
    <string name="reason_dac_state_unknown">DAC 状态未知</string>
